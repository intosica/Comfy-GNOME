{
    "id": "io.github.comfygnome.ComfyGnome",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "comfy-gnome",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Flatpak",
        "--env=GDK_BACKEND=x11"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "CARGO_HOME": "/run/build/comfy-gnome/cargo"
        }
    },
    "modules": [
        {
            "name": "comfy-gnome",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --locked",
                "install -Dm755 target/release/comfy-gnome /app/bin/comfy-gnome",
                "install -Dm644 data/io.github.comfygnome.ComfyGnome.desktop /app/share/applications/io.github.comfygnome.ComfyGnome.desktop",
                "install -Dm644 data/icons/hicolor/scalable/apps/io.github.comfygnome.ComfyGnome.svg /app/share/icons/hicolor/scalable/apps/io.github.comfygnome.ComfyGnome.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [
                        "target",
                        ".flatpak-builder",
                        "flatpak-build",
                        ".git",
                        ".pi"
                    ]
                }
            ]
        }
    ]
}
